APP_ENV=production
SECRET_KEY=<GENERATE-64-CHAR-HEX-KEY>
APP_ENCRYPTION_KEY=<USE-SAME-KEY-FROM-DEVELOPMENT-OR-GENERATE-NEW>
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/arsip_db
FRONTEND_URL=https://your-domain.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_UPLOAD_MB=10
UPLOAD_FOLDER=/var/uploads/arsip
COOKIE_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TLS=true
